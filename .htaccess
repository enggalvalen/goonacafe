# Goona Cafe - pengaturan Apache (berlaku di XAMPP dan hosting Apache)
Options -Indexes

# Blokir akses langsung ke berkas non-halaman
<FilesMatch "(\.sql|\.md|\.gitignore|db-local\.php|db-local\.example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

